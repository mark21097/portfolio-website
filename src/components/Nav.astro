---
import { navItems } from '../data/portfolio';
---

<!-- Desktop Nav: fixed top bar -->
<nav class="fixed top-0 left-0 right-0 z-[100] hidden md:block bg-p5-black/90 backdrop-blur-sm border-b border-p5-red/30" id="p5-nav">
  <div class="flex items-center justify-center gap-1 lg:gap-2 px-4 py-2 max-w-7xl mx-auto">
    {navItems.map((item) => (
      <a href={`#${item.id}`}
         class="group nav-item relative flex flex-col items-center"
         data-section={item.id}>
        <span class="nav-item-inner bg-p5-red text-white font-p5-body text-sm lg:text-base px-4 lg:px-5 py-1.5
                      -skew-x-12 inline-block
                      shadow-[2px_2px_0px_black] hover:shadow-[3px_3px_0px_black]
                      hover:translate-x-[-1px] hover:translate-y-[-1px]
                      transition-all duration-200 tracking-wider cursor-pointer">
          <span class="skew-x-12 inline-block">{item.label}</span>
        </span>
        <!-- Active indicator bar below the button — no layout impact on button text -->
        <span class="nav-cursor block w-full h-0.5 bg-white -skew-x-12 mt-px
                     opacity-0 group-hover:opacity-100 transition-opacity duration-150 pointer-events-none"></span>
      </a>
    ))}
  </div>
</nav>

<!-- Mobile Nav: hamburger -->
<button id="mobile-nav-toggle"
        class="fixed top-6 left-6 z-[110] md:hidden flex flex-col gap-1.5 cursor-pointer bg-transparent border-none p-2"
        aria-label="Toggle navigation">
  <span class="w-8 h-1 bg-p5-red -skew-x-12 transition-all" id="burger-1"></span>
  <span class="w-6 h-1 bg-white -skew-x-12 transition-all" id="burger-2"></span>
  <span class="w-8 h-1 bg-p5-red -skew-x-12 transition-all" id="burger-3"></span>
</button>

<!-- Mobile Nav Overlay -->
<div id="mobile-nav-overlay"
     class="fixed inset-0 bg-p5-black/95 z-[105] hidden flex-col items-center justify-center gap-6">
  {navItems.map((item) => (
    <a href={`#${item.id}`}
       class="mobile-nav-link group relative text-4xl font-p5 text-white hover:text-p5-red transition-colors tracking-wider uppercase">
      {item.label}
      <span class="absolute -bottom-1 left-0 w-full h-0.5 bg-p5-red -skew-x-12
                   opacity-0 group-hover:opacity-100 transition-opacity duration-150"></span>
    </a>
  ))}
</div>

<script>
  // Mobile nav toggle
  const toggle = document.getElementById('mobile-nav-toggle');
  const overlay = document.getElementById('mobile-nav-overlay');
  const links = document.querySelectorAll('.mobile-nav-link');

  if (toggle && overlay) {
    toggle.addEventListener('click', () => {
      overlay.classList.toggle('hidden');
      overlay.classList.toggle('flex');
    });
    links.forEach(link => {
      link.addEventListener('click', () => {
        overlay.classList.add('hidden');
        overlay.classList.remove('flex');
      });
    });
  }

  // Active section tracking — highlights nav item for the visible section
  const navItemEls = document.querySelectorAll<HTMLElement>('.nav-item[data-section]');
  const sections = Array.from(document.querySelectorAll<HTMLElement>('section[id]'));

  function setActive(id: string) {
    navItemEls.forEach(item => {
      const cursor = item.querySelector<HTMLElement>('.nav-cursor');
      const inner = item.querySelector<HTMLElement>('.nav-item-inner');
      if (item.dataset.section === id) {
        if (cursor) cursor.style.opacity = '1';
        if (inner) {
          inner.style.boxShadow = '3px 3px 0px black';
          inner.style.transform = 'translate(-1px, -1px)';
        }
      } else {
        if (cursor) cursor.style.opacity = '';
        if (inner) {
          inner.style.boxShadow = '';
          inner.style.transform = '';
        }
      }
    });
  }

  function updateActive() {
    // Find the last section whose top edge is at or above the middle of the viewport
    const mid = window.innerHeight / 2;
    let active = sections[0];
    for (const section of sections) {
      if (section.getBoundingClientRect().top <= mid) {
        active = section;
      }
    }
    if (active) setActive(active.id);
  }

  window.addEventListener('scroll', updateActive, { passive: true });
  updateActive();
</script>
