---
import { aboutInfo } from '../data/portfolio';
---

<section id="about" class="relative z-10 px-8 md:px-16 py-24">
  <div class="relative inline-block mb-16">
    <h2 class="font-p5 text-5xl md:text-7xl uppercase text-white tracking-tight">About Me</h2>
    <div class="absolute -bottom-2 left-0 w-full h-2 bg-p5-red -skew-x-12"></div>
  </div>

  <div class="flex flex-col lg:flex-row gap-12 items-start">
    <!-- Portrait tarot card -->
    <div class="relative shrink-0" data-animate>
      <div class="w-72 -rotate-3 shadow-[8px_8px_0px_#FF0000] relative">
        <!-- Tarot card outer frame -->
        <div class="border-4 border-white bg-p5-gray">
          <!-- Inner ornamental border -->
          <div class="m-2 border border-white/30 p-1">
            <img
              src="/mark_phouiphiphath_portrait.png"
              alt="Mark V.P."
              class="w-full h-auto block"
            />
          </div>
          <!-- Tarot card bottom label -->
          <div class="py-3 text-center border-t border-white/30 mx-2 mb-2">
            <span class="font-p5-accent text-white text-lg tracking-wider">Mark Valinh Phouiphiphath</span>
          </div>
        </div>
      </div>
      <!-- Arcana badge -->
      <div class="absolute -bottom-4 -right-4 bg-p5-red text-white px-4 py-1
                  font-p5-body text-sm -skew-x-12 shadow-[2px_2px_0px_black] z-10">
        <span class="skew-x-12 inline-block tracking-wider">THE MVP</span>
      </div>
    </div>

    <!-- Info labels -->
    <div class="lg:flex-1 space-y-5" data-animate>
      {aboutInfo.map((item) => (
        <div class="flex flex-col md:flex-row md:items-center gap-2 md:gap-4 group">
          <div class="bg-p5-red text-white px-4 py-1 -skew-x-12 font-p5-body text-sm
                      min-w-[140px] text-center shrink-0 shadow-[2px_2px_0px_black]">
            <span class="skew-x-12 inline-block tracking-wider">{item.label}</span>
          </div>
          <p class="text-white/80 font-p5-body text-xl leading-relaxed tracking-wide">{item.value}</p>
        </div>
      ))}
    </div>

    <!-- Tech Stack panel -->
    <div class="shrink-0 w-64 lg:w-80" data-animate>
      <div class="relative inline-block mb-6">
        <h3 class="font-p5 text-3xl uppercase text-white tracking-tight">Tech Stack</h3>
        <div class="absolute -bottom-1 left-0 w-full h-1 bg-p5-red -skew-x-12"></div>
      </div>

      {[
        { label: 'LANGUAGES', skills: ['Python', 'TypeScript', 'JavaScript', 'C/C++', 'Java', 'R', 'Assembly'] },
        { label: 'FRONTEND', skills: ['React', 'Next.js', 'HTML/CSS', 'Tailwind CSS'] },
        { label: 'BACKEND', skills: ['FastAPI', 'Fastify', 'REST API'] },
        { label: 'DATABASES', skills: ['PostgreSQL', 'SQL', 'Firebase'] },
        { label: 'ML / AI', skills: ['Scikit-Learn', 'TensorFlow', 'PyTorch', 'Pandas', 'NumPy', 'NLTK'] },
        { label: 'TOOLS', skills: ['Docker', 'AWS', 'Git', 'GitHub', 'GitLab'] },
      ].map(group => (
        <div class="mb-5">
          <div class="bg-p5-red text-white px-3 py-0.5 -skew-x-12 font-p5-body text-sm
                      inline-block mb-2 shadow-[2px_2px_0px_black]">
            <span class="skew-x-12 inline-block tracking-wider">{group.label}</span>
          </div>
          <div class="flex flex-wrap gap-2">
            {group.skills.map(skill => (
              <span class="font-p5-body text-base text-white/80 border border-p5-red/40
                           px-2 py-0.5 -skew-x-6 bg-p5-gray/80 tracking-wide">
                <span class="skew-x-6 inline-block">{skill}</span>
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- P5R Dialogue Box -->
  <div class="p5-dialogue" data-animate>
    <div class="p5-dialogue-name font-p5-body">Mark</div>
    <div class="p5-dialogue-outer">
      <div class="p5-dialogue-box">
        <p class="font-p5-body text-white text-lg md:text-xl leading-relaxed tracking-wide">
          Hi, I'm Mark — a fourth-year CS student at UCI specializing in Intelligent Systems.
          I'm currently interning as a Data Scientist & ML Engineer at Boundary RSS, where I build
          classification models and data pipelines that have improved predictive accuracy by 25%.
          I love working at the intersection of machine learning and full-stack development, turning
          raw data into real products. Right now, I'm looking for Summer/Fall 2026 opportunities
          in Data Science or ML Engineering.
        </p>
        <!-- Right arrow decoration -->
        <div class="p5-dialogue-arrow-right"></div>
      </div>
    </div>
  </div>
</section>
