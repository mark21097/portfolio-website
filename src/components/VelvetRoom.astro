---

<section id="resume" class="relative z-10 px-8 md:px-16 py-24">
  <!-- Section header -->
  <div class="relative inline-block mb-16">
    <h2 class="font-p5 text-5xl md:text-7xl uppercase text-white tracking-tight">Resume</h2>
    <div class="absolute -bottom-2 left-0 w-full h-2 bg-p5-red -skew-x-12"></div>
  </div>

  <!-- Contact links -->
  <div class="flex flex-wrap gap-6 mb-20">
    {[
      { label: 'EMAIL', href: 'mailto:placeholder@email.com' },
      { label: 'GITHUB', href: 'https://github.com/mark21097' },
      { label: 'LINKEDIN', href: 'https://www.linkedin.com/in/mark-phouiphiphath' },
    ].map((link) => (
      <a href={link.href} target="_blank" rel="noopener"
         class="inline-block bg-p5-red text-white font-p5 px-8 py-3 -skew-x-12 text-xl
                shadow-[4px_4px_0px_black] hover:shadow-[6px_6px_0px_black]
                hover:translate-x-[-2px] hover:translate-y-[-2px]
                transition-all uppercase tracking-wider">
        <span class="skew-x-12 inline-block">{link.label}</span>
      </a>
    ))}
  </div>

  <!-- Calling Card -->
  <div class="max-w-2xl mx-auto" data-animate>
    <div class="bg-white text-p5-black p-10 md:p-14 rotate-1
                shadow-[8px_8px_0px_#FF0000] border-4 border-p5-black relative">
      <!-- Decorative corner marks -->
      <div class="absolute top-3 left-3 w-6 h-6 border-t-2 border-l-2 border-p5-red"></div>
      <div class="absolute top-3 right-3 w-6 h-6 border-t-2 border-r-2 border-p5-red"></div>
      <div class="absolute bottom-3 left-3 w-6 h-6 border-b-2 border-l-2 border-p5-red"></div>
      <div class="absolute bottom-3 right-3 w-6 h-6 border-b-2 border-r-2 border-p5-red"></div>

      <p class="font-p5-accent text-lg md:text-xl leading-relaxed">
        Sir/Madam, we have decided to make you aware of our skills and expertise.
        We will take your project requirements and deliver beyond expectations.
        Your heart will be stolen by our craft.
      </p>
      <p class="font-p5-accent text-lg mt-6 text-p5-red">
        &mdash; Mark Valinh Phouiphiphath
      </p>

      <div class="mt-8 flex justify-center">
        <button id="resume-reveal-btn"
                class="inline-block bg-p5-red text-white font-p5 px-8 py-3
                       -skew-x-12 shadow-[4px_4px_0px_black]
                       hover:shadow-[6px_6px_0px_black] hover:translate-x-[-2px] hover:translate-y-[-2px]
                       transition-all uppercase text-lg tracking-wider"
                type="button">
          <span class="skew-x-12 inline-block">Reveal Resume</span>
        </button>
      </div>
    </div>
  </div>
</section>

<!-- Resume modal -->
<div id="resume-modal" class="resume-modal hidden" role="dialog" aria-modal="true" aria-hidden="true" aria-labelledby="resume-title">
  <div id="resume-modal-overlay" class="resume-overlay"></div>

  <div class="resume-card" role="document">
    <header class="resume-card-header">
      <h3 id="resume-title" class="resume-title">MARK PHOUIPHIPHATH — RESUME</h3>
    </header>

    <div class="resume-body">
      <div id="resume-embed-wrap" class="resume-embed-wrap">
        <!-- PDF gets injected here dynamically -->
      </div>
    </div>

    <footer class="resume-card-foot">
      <a href="/mark_phouiphiphath_ds_resume.pdf" target="_blank" rel="noopener" class="resume-download-btn">
        Open in New Tab
      </a>
      <a href="/mark_phouiphiphath_ds_resume.pdf" download class="resume-download-btn" style="margin-left:.5rem;">
        Download
      </a>
      <button id="resume-modal-close" class="resume-download-btn" type="button" style="margin-left:.5rem;">Close</button>
    </footer>
  </div>
</div>

<script>
  (function () {
    const PDF_URL = '/mark_phouiphiphath_ds_resume.pdf';
    const openBtn = document.getElementById('resume-reveal-btn');
    const modal = document.getElementById('resume-modal');
    const closeBtn = document.getElementById('resume-modal-close');
    const overlay = document.getElementById('resume-modal-overlay');
    const embedWrap = document.getElementById('resume-embed-wrap');
    let lastFocused = null;
    let pdfInjected = false;

    if (!openBtn || !modal || !embedWrap) return;

    async function injectPDF() {
      if (pdfInjected) return;
      pdfInjected = true;
      embedWrap.innerHTML = '<p style="text-align:center;padding:2rem;color:#999;">Loading resume...</p>';

      try {
        var pdfjsLib = await import('https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.2.67/pdf.min.mjs');
        pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.2.67/pdf.worker.min.mjs';

        var pdf = await pdfjsLib.getDocument(PDF_URL).promise;
        embedWrap.innerHTML = '';
        embedWrap.style.overflowY = 'auto';

        // Render at 2x for crisp quality; CSS width:100% auto-fits to container
        for (var i = 1; i <= pdf.numPages; i++) {
          var page = await pdf.getPage(i);
          var viewport = page.getViewport({ scale: 2 });
          var canvas = document.createElement('canvas');
          canvas.width = viewport.width;
          canvas.height = viewport.height;
          canvas.style.width = '100%';
          canvas.style.height = 'auto';
          canvas.style.display = 'block';
          var ctx = canvas.getContext('2d');
          await page.render({ canvasContext: ctx, viewport: viewport }).promise;
          embedWrap.appendChild(canvas);
        }
      } catch (err) {
        console.error('PDF render error:', err);
        embedWrap.innerHTML =
          '<p style="text-align:center;padding:2rem;font-size:1.1rem;color:#333;">' +
          'Could not load PDF preview.<br/>' +
          '<a href="' + PDF_URL + '" target="_blank" rel="noopener" ' +
          'style="color:#ff0000;font-weight:bold;text-decoration:underline;">Open Resume in New Tab</a></p>';
      }
    }

    function openModal() {
      lastFocused = document.activeElement;
      modal.classList.remove('hidden');
      modal.classList.add('open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      injectPDF();
      const first = modal.querySelector('button, a, [tabindex]:not([tabindex="-1"])');
      if (first) first.focus();
      document.addEventListener('keydown', onKeyDown);
    }

    function closeModal() {
      modal.classList.remove('open');
      modal.classList.add('hidden');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      if (lastFocused && typeof lastFocused.focus === 'function') lastFocused.focus();
      document.removeEventListener('keydown', onKeyDown);
    }

    function onKeyDown(e) {
      if (e.key === 'Escape') { e.preventDefault(); closeModal(); return; }
      if (e.key === 'Tab') {
        const focusable = modal.querySelectorAll('a[href], button:not([disabled]), textarea, input, select, [tabindex]:not([tabindex="-1"])');
        if (!focusable.length) return;
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (e.shiftKey) {
          if (document.activeElement === first) { e.preventDefault(); last.focus(); }
        } else {
          if (document.activeElement === last) { e.preventDefault(); first.focus(); }
        }
      }
    }

    openBtn.addEventListener('click', function (e) { e.preventDefault(); openModal(); });
    closeBtn && closeBtn.addEventListener('click', function (e) { e.preventDefault(); closeModal(); });
    overlay && overlay.addEventListener('click', function (e) { if (e.target === overlay) closeModal(); });
  })();
</script>
