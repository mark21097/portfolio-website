---
const experiences = [
  {
    company: 'Boundary RSS',
    location: 'Remote',
    title: 'Data Scientist',
    date: '[2026.01 — PRESENT]',
    status: 'ACTIVE',
    bullets: [
      'Built geospatial anomaly-to-label workflows over multi-band raster feature stacks and trained Random Forest + XGBoost models, improving held-out validation predictive accuracy by up to 25% using standard evaluation metrics (ROC-AUC/F1 for classification, MAE/RMSE for regression).',
      'Engineered preprocessing + feature selection pipelines (outlier handling, normalization, uncertainty-aware thresholding) that improved model generalization by ~20% in cross-validation.',
      'Designed reproducible experiment runs and robust evaluation protocols (ablation studies, calibration checks, leakage-safe splits), increasing data reliability for downstream modeling by ~30%.',
      'Partnered in Agile sprints to deliver on time and tighten iteration loops, reducing end-to-end modeling turnaround by ~35%.',
    ],
  },
  {
    company: 'Fusion',
    location: 'Irvine, CA',
    title: 'Full Stack Developer',
    date: '[2024.11 — 2025.05]',
    status: 'COMPLETE',
    bullets: [
      'Built and deployed a full-stack mentorship platform for 100+ students with Firebase Firestore, role-based auth, and a swipe-to-match algorithm.',
      'Translated 15+ Figma wireframes into responsive UI components, reducing feature development time by 25%.',
      'Collaborated with a team of 10+ developers and designers in an Agile workflow to ship profile creation, filtering, and a full matching pipeline.',
    ],
  },
];
---

<section id="experience" class="relative z-10 px-8 md:px-16 py-24">
  <!-- Section header -->
  <div class="relative inline-block mb-16">
    <div class="mb-1">
      <span class="bg-p5-red text-white font-p5-body text-xs tracking-[0.25em] px-2 py-0.5 -skew-x-12 inline-block shadow-[2px_2px_0px_black]">
        <span class="skew-x-12 inline-block">// SYS.RECORD</span>
      </span>
    </div>
    <h2 class="font-p5 text-5xl md:text-7xl uppercase text-white tracking-tight">Experience</h2>
    <div class="absolute -bottom-2 left-0 w-full h-1.5 bg-p5-red -skew-x-12"></div>
    <div class="absolute -bottom-4 left-4 w-3/4 h-0.5 bg-p5-red/40 -skew-x-12"></div>
  </div>

  <!-- Experience cards -->
  <div class="space-y-10">
    {experiences.map((exp) => (
      <div class="border-l-4 border-p5-red pl-6 md:pl-10 relative" data-animate>
        <!-- Red dot on the timeline -->
        <div class="absolute -left-[11px] top-0 w-[18px] h-[18px] bg-p5-red rotate-45 shadow-[2px_2px_0px_black]"></div>

        <!-- Header row: company badge + status + date -->
        <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-2 mb-3">
          <div class="flex flex-wrap items-center gap-3">
            <div class="bg-p5-red text-white px-4 py-1 -skew-x-12 font-p5-body text-sm
                        shadow-[2px_2px_0px_black]">
              <span class="skew-x-12 inline-block tracking-wider">{exp.company}</span>
            </div>
            <span class="font-p5-body text-white/40 text-sm tracking-wider">{exp.location}</span>
            <!-- Status badge -->
            <div class={`px-3 py-0.5 -skew-x-12 font-p5-body text-xs shadow-[1px_1px_0px_black] ${exp.status === 'ACTIVE' ? 'bg-emerald-600 text-white' : 'bg-[#B8860B] text-white'}`}>
              <span class="skew-x-12 inline-block tracking-widest">
                {exp.status === 'ACTIVE' ? '● ACTIVE' : '✓ COMPLETE'}
              </span>
            </div>
          </div>
          <span class="font-p5-body text-white/40 text-sm tracking-wider">{exp.date}</span>
        </div>

        <!-- Title -->
        <h3 class="font-p5-body text-white text-xl md:text-2xl tracking-wide mb-4">{exp.title}</h3>

        <!-- Bullets -->
        <ul class="space-y-3">
          {exp.bullets.map((bullet) => (
            <li class="flex gap-3 items-start">
              <span class="text-p5-red font-p5 text-xs mt-1.5 shrink-0">&#9654;</span>
              <span class="font-p5-body text-white/70 text-base md:text-lg leading-relaxed tracking-wide">{bullet}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
